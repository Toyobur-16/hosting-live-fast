<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HostingLiveFast" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/slate_950</item>
        <item name="android:navigationBarColor">@color/slate_950</item>
        <item name="android:windowBackground">@color/slate_950</item>
    </style>

    <style name="Theme.HostingLiveFast.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/slate_950</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HostingLiveFast</item>
    </style>
</resources>
