rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts and balances (by userId and by email)
    match /accounts/{userId} {
      allow read, write: if true;
    }

    // Bots collection
    match /bots/{botId} {
      allow read, write: if true;
    }

    // Bot workspaces collection (persists bot code files & archives across container restarts)
    match /bot_workspaces/{workspaceId} {
      allow read, write: if true;
    }

    // Static websites collection
    match /websites/{websiteId} {
      allow read, write: if true;
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Plan & deposit requests collection
    match /plan_requests/{reqId} {
      allow read, write: if true;
    }

    // Deposits collection
    match /deposits/{depId} {
      allow read, write: if true;
    }

    // Site settings, logo URL, title, taglines
    match /site_settings/{docId} {
      allow read, write: if true;
    }

    // Site configuration documents
    match /config/{docId} {
      allow read, write: if true;
    }

    // Banners collection
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Site uploaded images (logo, icon, banners stored in Firestore)
    match /site_images/{imageId} {
      allow read, write: if true;
    }

    // Social Tasks
    match /social_tasks/{taskId} {
      allow read, write: if true;
    }

    // Task completions and proofs
    match /task_completions/{completionId} {
      allow read, write: if true;
    }

    // Wallet balance transactions
    match /wallet_transactions/{txId} {
      allow read, write: if true;
    }

    // Plans and announcements
    match /plans/{planId} {
      allow read, write: if true;
    }

    match /announcements/{annId} {
      allow read, write: if true;
    }

    // Catch-all for full application storage in Firestore
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
