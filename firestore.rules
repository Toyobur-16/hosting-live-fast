rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User accounts collection
    match /accounts/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Plan & deposit requests collection
    match /plan_requests/{reqId} {
      allow read: if true;
      allow write: if true;
    }

    match /deposits/{depId} {
      allow read: if true;
      allow write: if true;
    }

    // Site settings & branding (logo, title, taglines)
    match /site_settings/{docId} {
      allow read, write: if true;
    }

    // Site configurations (site_settings, banners, payment_settings, deposit_methods)
    match /config/{docId} {
      allow read, write: if true;
    }

    // Banners collection
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Site uploaded images collection (stores base64 logos and pictures permanently in Firestore)
    match /site_images/{imageId} {
      allow read, write: if true;
    }

    // Cloud SMTP Email Relay Outbox
    match /email_outbox/{jobId} {
      allow read, write: if true;
    }

    // Default allow read for public site collections, write allowed
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
