    "@types/nodemailer": "^6.4.17",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "nodemailer": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.2",
